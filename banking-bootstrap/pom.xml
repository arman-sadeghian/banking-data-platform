<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent -->
    <parent>
        <groupId>com.sadeghian.banking</groupId>
        <artifactId>banking-data-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>banking-bootstrap</artifactId>
    <name>Banking Bootstrap</name>
    <description>Spring Boot bootstrap and configuration for banking data platform</description>

    <packaging>jar</packaging>

    <dependencies>

        <!-- Web server + MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Internal modules -->
        <dependency>
            <groupId>com.sadeghian.banking</groupId>
            <artifactId>banking-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.sadeghian.banking</groupId>
            <artifactId>banking-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.sadeghian.banking</groupId>
            <artifactId>banking-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

    </dependencies>


    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
